DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL 연결 방법 1: DATABASE_URL 한 줄 사용 (권장)
# 특수문자가 있는 비밀번호는 URL 인코딩해서 넣어주세요.
DATABASE_URL=

# PostgreSQL 연결 방법 2: 개별 필드 사용
POSTGRES_DB=company_data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# 비밀번호 인코딩 문제가 있으면 POSTGRES_PASSWORD_B64를 사용하세요 (UTF-8 문자열의 Base64)
POSTGRES_PASSWORD_B64=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_OPTIONS=-c client_encoding=UTF8
# 아래 기본값으로 libpq 서비스/패스파일 자동 참조를 차단합니다(Windows 충돌 방지)
POSTGRES_DISABLE_PGSERVICE=True
POSTGRES_DISABLE_PGPASSFILE=True
# 필요시 직접 지정
POSTGRES_SERVICE=
POSTGRES_PASSFILE=
# 위 값은 ""(따옴표 포함 빈문자열)로 넣지 마세요. 미사용 시 그냥 비워두세요.

# Windows/인코딩 이슈가 있을 때 UTF8 강제
PGCLIENTENCODING=UTF8

# 개발/테스트 시 PostgreSQL 없이 실행하려면 True
USE_SQLITE=False
